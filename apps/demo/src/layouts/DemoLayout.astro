---
import '../styles.css';

interface Props {
  title?: string;
}

const {title = 'Floating UI Plus Web Components demo'} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Lit-powered Floating UI custom elements demonstrated in Astro."
    />
    <title>{title}</title>
  </head>
  <body>
    <header class="masthead">
      <div class="eyebrow">
        <span class="pulse"></span> floating-ui-plus / web components
      </div>
      <div class="header-row">
        <div>
          <a
            class="brand-link"
            href="/web-components"
            aria-label="Floating UI Plus Web Components demo home"
          >
            <h1>
              Floating UI<br /><em>Plus</em>
              <span class="framework-title">Web Components</span>
            </h1>
          </a>
          <p class="lede">
            Lit-powered custom elements and framework-neutral interactions,<br
            />rendered by Astro.
          </p>
        </div>
        <div class="coordinate-stamp" aria-label="Current demo status">
          <span class="stamp-label">LIVE SIGNAL</span>
          <strong>07</strong>
          <span class="stamp-caption">
            @floating-ui-plus/web-components + Astro 7
          </span>
        </div>
      </div>
      <nav class="route-nav" aria-label="Demo routes">
        <a href="/">Frameworks</a>
        <a href="/web-components">All examples</a>
        <a href="/web-components/tooltip">Tooltip</a>
        <a href="/web-components/popover">Popover</a>
        <a href="/web-components/menu">Menu</a>
        <a href="/web-components/nested-menu">Nested menu</a>
        <a href="/web-components/client-point">Cursor</a>
        <a href="/web-components/combobox">Combobox</a>
        <a href="/web-components/placement">Placement</a>
        <a href="/web-components/middleware">Middleware</a>
        <a href="/web-components/modal">Modal</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="footer">
      <span>floating-ui-plus</span>
      <span>@floating-ui-plus/web-components / Lit 3 / Astro 7</span>
      <span class="footer-status">
        <i></i>
        <span id="demo-status">Choose an example route</span>
      </span>
    </footer>
    <script>
      import '@floating-ui-plus/web-components';
      import {initializeDemos} from '../scripts/initialize-demos';

      document.addEventListener('floating-demo-action', (event) => {
        const status = document.querySelector('#demo-status');
        if (
          status &&
          event instanceof CustomEvent &&
          typeof event.detail === 'string'
        ) {
          status.textContent = event.detail;
        }
      });
      initializeDemos();
    </script>
  </body>
</html>
