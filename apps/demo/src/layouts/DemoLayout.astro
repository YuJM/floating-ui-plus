---
import SeoHead from '../components/SeoHead.astro';
import {Box, ChevronDown, House} from 'lucide-astro';
import {siVuedotjs} from 'simple-icons';
import {frameworkQuery, type ExampleId} from '../demo-registry';
import {getSeoMetadata} from '../seo';
import {getRelativeLocaleUrl} from '../locale-url';
import * as m from '../paraglide/messages';
import {getExamples, type Locale} from '../i18n';
import {EXAMPLE_ICONS} from '../example-icons';
import {latestRelease} from '../changelog';
import '../styles.css';
import '../vue/styles.css';

interface Props {
  title?: string;
  description?: string;
  example?: ExampleId;
  examplePath?: string;
  locale: Locale;
  noindex?: boolean;
}

const {title, description, example, examplePath, noindex, locale} = Astro.props;
const options = {locale};
const examples = getExamples(locale);
const BETA_EXAMPLE_IDS = new Set(['sheet', 'toast', 'command']);
const activeExample = examples.find((item) => item.id === example);
const ActiveExampleIcon = activeExample ? EXAMPLE_ICONS[activeExample.id] : House;
const framework = Astro.url.searchParams.get('framework') === 'vue' ? 'vue' : 'web-components';
const isEmbed = Astro.url.searchParams.get('embed') === '1';
const frameworkSearch = `?framework=${frameworkQuery(framework)}`;
const localizedExamplePath = examplePath ?? example ?? '';
const routeMetadata = getSeoMetadata(Astro.url.pathname, locale);
const metadata = {
  ...routeMetadata,
  ...(title ? {title} : {}),
  ...(description ? {description} : {}),
  ...(noindex !== undefined ? {noindex} : {}),
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <SeoHead metadata={metadata} locale={locale} />
    <script is:inline>
      document.documentElement.dataset.framework =
        new URL(window.location.href).searchParams.get('framework') === 'vue'
          ? 'vue'
          : 'web-components';
      document.documentElement.dataset.embed =
        new URL(window.location.href).searchParams.get('embed') === '1'
          ? 'true'
          : 'false';
    </script>
    <script>
      import {enableDemoMockServer} from '../mocks/browser';

      // The Service Worker must be active before either framework creates an
      // async search source, otherwise the first request can bypass MSW.
      await enableDemoMockServer();
      // Upgrade floating elements before per-example configuration modules run.
      import '@floating-ui-plus/web-components';
    </script>
  </head>
  <body>
    <floating-ui-demo class:list={['demo-shell', example ? 'is-example' : 'is-home', isEmbed && 'is-embedded']}>
    <aside class="release-banner" aria-label={m.release_banner_label(undefined, options)}>
      <div class="container mx-auto flex flex-wrap items-center gap-x-3 gap-y-1 px-5 py-2.5 sm:px-8">
        <span class="release-banner-label">{m.release_banner_label(undefined, options)}</span>
        <span class="release-banner-version">v{latestRelease.version}</span>
        <span class="release-banner-summary">{latestRelease.summary}</span>
        <a href="/changelog">{m.release_banner_link(undefined, options)} <span aria-hidden="true">↗</span></a>
      </div>
    </aside>
    <div class="global-utilities border-b border-border/70 bg-surface/60">
      <div class="container mx-auto flex items-center justify-end gap-3 px-5 py-3 sm:px-8">
        <a class="docs-nav-link" href="/docs">Docs</a>
        <div class="framework-switch" role="group" aria-label={m.framework_label(undefined, options)} title={m.framework_switch_title(undefined, options)}>
          <a id="framework-switch-web-components" href={`${getRelativeLocaleUrl(locale, localizedExamplePath)}?framework=wc`} aria-label={m.framework_web_components(undefined, options)} title={m.framework_web_components_title(undefined, options)}>
            <Box aria-hidden="true" size={15} strokeWidth={1.8} />
          </a>
          <a id="framework-switch-vue" href={`${getRelativeLocaleUrl(locale, localizedExamplePath)}?framework=vue`} aria-label="Vue" title={m.framework_vue_title(undefined, options)}>
            <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
              <path d={siVuedotjs.path} />
            </svg>
          </a>
        </div>
        <nav class="language-switch" aria-label={m.language_label(undefined, options)}>
          {(['en', 'ko', 'ja'] as const).map((target) => (
            <a class="preserve-query" href={`${getRelativeLocaleUrl(target, localizedExamplePath)}${frameworkSearch}`} aria-current={target === locale ? 'page' : undefined}>
              {{en: 'English', ko: '한국어', ja: '日本語'}[target]}
            </a>
          ))}
        </nav>
      </div>
    </div>
    <header class="masthead container mx-auto px-5 sm:px-8">
      <div class="header-row">
        <div>
          <a
            class="brand-link preserve-framework"
            href={`${getRelativeLocaleUrl(locale)}${frameworkSearch}`}
            aria-label={m.site_name(undefined, options)}
          >
            <h1>
              Floating UI<br /><em>Plus</em>
            </h1>
          </a>
          <p class="lede">
            {m.brand_lede(undefined, options)}
          </p>
        </div>
      </div>
    </header>
    <nav class="integrated-nav" aria-label={m.nav_examples(undefined, options)}>
      <floating-root
        class="pattern-picker"
        id="pattern-picker-root"
        interactions="click dismiss"
      >
        <floating-reference>
          <button class="pattern-picker-trigger" type="button" aria-label={m.nav_examples(undefined, options)}>
            <span class="pattern-picker-current">
              <ActiveExampleIcon aria-hidden="true" size={16} strokeWidth={1.8} />
              <span>{activeExample?.label ?? m.site_name(undefined, options)}</span>
            </span>
            <ChevronDown class="pattern-picker-chevron" aria-hidden="true" size={16} strokeWidth={1.8} />
          </button>
        </floating-reference>
        <template slot="content">
          <div class="pattern-picker-panel">
            <a class="preserve-framework" href={`${getRelativeLocaleUrl(locale)}${frameworkSearch}`} aria-current={example ? undefined : 'page'}>
              <House aria-hidden="true" size={16} strokeWidth={1.8} />
              <span>{m.site_name(undefined, options)}</span>
            </a>
            {
              examples.map((item) => (
                <a
                  href={`${getRelativeLocaleUrl(locale, item.id)}?framework=wc`}
                  class:list={[
                    'preserve-framework',
                    {'pattern-picker-link--beta': BETA_EXAMPLE_IDS.has(item.id)},
                  ]}
                  aria-current={example === item.id ? 'page' : undefined}
                >
                  {(() => {
                    const Icon = EXAMPLE_ICONS[item.id];
                    return <Icon aria-hidden="true" size={16} strokeWidth={1.8} />;
                  })()}
                  {item.label}
                </a>
              ))
            }
          </div>
        </template>
      </floating-root>
    </nav>
    <main class="container mx-auto px-5 sm:px-8">
      <slot />
    </main>
    <script>
      import {
        FloatingRootElement,
        flip,
        offset,
        shift,
        size,
      } from '@floating-ui-plus/web-components';
      import {resolveFramework} from '../demo-registry';

      function applyFramework(link: HTMLAnchorElement, framework: 'vue' | 'web-components') {
        const url = new URL(
          link.getAttribute('href') ?? link.href,
          window.location.href,
        );
        url.searchParams.set('framework', framework === 'vue' ? 'vue' : 'wc');
        link.href = url.href;
      }

      function initializeIntegratedDemo() {
        const framework = resolveFramework(
          new URL(window.location.href).searchParams.get('framework'),
        );
        document.documentElement.dataset.framework = framework;
        const frameworkPackage =
          framework === 'vue'
            ? '@floating-ui-plus/vue'
            : '@floating-ui-plus/web-components';
        document
          .querySelectorAll<HTMLElement>('.framework-package')
          .forEach((element) => {
            element.textContent = frameworkPackage;
          });
        document
          .querySelectorAll<HTMLElement>('.framework-name')
          .forEach((element) => {
            element.textContent = framework;
          });
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', framework === 'vue' ? '#effaf5' : '#edf3ff');

        const queryLinks = (selector: string) => [
          ...Array.from(document.querySelectorAll<HTMLAnchorElement>(selector)),
          ...Array.from(document.querySelectorAll('template')).flatMap((template) =>
            Array.from(template.content.querySelectorAll<HTMLAnchorElement>(selector)),
          ),
        ];
        queryLinks('.preserve-framework').forEach((link) => applyFramework(link, framework));
        queryLinks('.preserve-query').forEach((link) => {
          const url = new URL(link.href);
          url.search = window.location.search;
          link.href = url.href;
        });
        const frameworkObserver = new MutationObserver(() => {
          queryLinks('.preserve-framework').forEach((link) =>
            applyFramework(link, framework),
          );
        });
        frameworkObserver.observe(document.body, {childList: true, subtree: true});
        document.addEventListener('click', (event) => {
          const link = event.composedPath().find(
            (node): node is HTMLAnchorElement =>
              node instanceof HTMLAnchorElement &&
              node.matches('.preserve-framework'),
          );
          if (link) applyFramework(link, framework);
        }, true);
        document.addEventListener('floatingmount', (event) => {
          const element = (event as CustomEvent<{element?: unknown}>).detail?.element;
          if (!(element instanceof Element)) return;
          element.querySelectorAll<HTMLAnchorElement>('.preserve-framework').forEach((link) => applyFramework(link, framework));
        });
        document.querySelectorAll<HTMLAnchorElement>('#framework-switch-web-components, #framework-switch-vue').forEach((link) => {
          const target = link.id.replace('framework-switch-', '');
          const currentUrl = new URL(window.location.href);
          const source = currentUrl.searchParams.get('source');
          const url = new URL(link.href);
          if (source === 'fuzzy' || source === 'server') {
            url.searchParams.set('source', source);
          }
          link.href = url.href;
          link.setAttribute('aria-current', target === framework ? 'page' : 'false');
        });
      }

      const runIntegratedDemo = () => initializeIntegratedDemo();
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', runIntegratedDemo, {once: true});
      } else {
        runIntegratedDemo();
      }

      customElements.whenDefined('floating-root').then(() => {
        const patternPicker = FloatingRootElement.query(
          document,
          '#pattern-picker-root',
        );
        const syncPatternPickerLinks = (element?: Element) => {
          const framework = resolveFramework(
            new URL(window.location.href).searchParams.get('framework'),
          );
          (element ?? patternPicker.floatingElement)
            ?.querySelectorAll<HTMLAnchorElement>('.preserve-framework')
            .forEach((link) => applyFramework(link, framework));
        };
        syncPatternPickerLinks();
        patternPicker.addEventListener('floatingmount', (event) => {
          const element = (event as CustomEvent<{element?: unknown}>).detail?.element;
          syncPatternPickerLinks(element instanceof Element ? element : undefined);
        });

        patternPicker.configure({
          middleware: [
            offset(8),
            flip({padding: 16}),
            shift({padding: 16}),
            size({
              padding: 16,
              apply({availableWidth, availableHeight, elements, rects}) {
                const width = Math.max(
                  0,
                  Math.min(rects.reference.width, availableWidth),
                );
                const maxHeight = `${Math.max(0, availableHeight)}px`;
                Object.assign(elements.floating.style, {
                  width: `${width}px`,
                  maxHeight,
                  overflowY: 'auto',
                  overscrollBehavior: 'contain',
                });
              },
            }),
          ],
        });
      });
    </script>
    </floating-ui-demo>
  </body>
</html>
