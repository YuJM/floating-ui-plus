---
import LocalizedExamplePage from '../../../components/LocalizedExamplePage.astro';
import {COMBOBOX_SOURCES} from '../../../i18n';

export function getStaticPaths() {
  return COMBOBOX_SOURCES.map((source) => ({
    params: {example: 'combobox', source},
  }));
}

const {source} = Astro.params;
---

<LocalizedExamplePage locale="ja" example="combobox" source={source as typeof COMBOBOX_SOURCES[number]} />
