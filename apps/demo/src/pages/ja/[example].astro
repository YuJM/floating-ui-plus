---
import LocalizedExamplePage from '../../components/LocalizedExamplePage.astro';
import {EXAMPLE_IDS, isComboboxSource} from '../../i18n';
export function getStaticPaths() {
  return EXAMPLE_IDS.map((example) => ({params: {example}}));
}
const {example} = Astro.params;
const requestedSource = Astro.url.searchParams.get('source') ?? undefined;
const source = isComboboxSource(requestedSource)
  ? requestedSource
  : undefined;
---
<LocalizedExamplePage locale="ja" example={example as typeof EXAMPLE_IDS[number]} source={source} />
