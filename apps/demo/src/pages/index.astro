---
import {EXAMPLES} from '../demo-registry';
import {ArrowRight, Layers, Search, Workflow} from 'lucide-astro';
import {siNpm} from 'simple-icons';
import DemoLayout from '../layouts/DemoLayout.astro';
import {getNpmPackages} from '../npm-packages';

const npmPackages = getNpmPackages();
---

<DemoLayout>
  <section class="demo-overview" aria-labelledby="demo-overview-title">
    <div class="demo-overview-copy">
      <h2 id="demo-overview-title"><Layers aria-hidden="true" size={32} strokeWidth={1.5} /> Choose an<br /><span>interaction.</span></h2>
      <p>
        Each route keeps one interaction in view. Switch its implementation
        between Web Components and Vue without leaving the example.
      </p>
    </div>
    <div class="demo-example-list" aria-label="Examples">
      {
        EXAMPLES.map((example) => (
          <a
            class="demo-example-link"
            href={`/${example.id}?framework=web-components`}
            data-example-link={example.id}
          >
            <strong>{example.label}</strong>
            <span>{example.description} <ArrowRight aria-hidden="true" size={16} strokeWidth={1.8} /></span>
          </a>
        ))
      }
    </div>
  </section>
  <section class="npm-releases" aria-labelledby="npm-releases-title">
    <div class="npm-releases-copy">
      <h2 id="npm-releases-title">Install the <span>implementation you ship.</span></h2>
      <p>Published package versions are read from npm when you open this page.</p>
    </div>
    <div class="npm-package-list" aria-label="Published npm packages">
      {
        npmPackages.map((pkg) => (
          <a
            class="npm-package-link"
            href={pkg.href}
            target="_blank"
            rel="noreferrer"
            data-npm-package={pkg.name}
          >
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d={siNpm.path} /></svg>
            <span class="npm-package-copy">
              <strong>{pkg.name}</strong>
              <small data-npm-package-description>{pkg.description ?? `Open ${pkg.label} on npm`}</small>
            </span>
            <span class="npm-package-version" data-npm-package-version>{pkg.version ? `v${pkg.version}` : 'npm'}</span>
          </a>
        ))
      }
    </div>
  </section>
  <section class="why-plus" aria-labelledby="why-plus-title">
    <div>
      <h2 id="why-plus-title">Positioning is only<br /><span>the beginning.</span></h2>
    </div>
    <div class="why-plus-copy">
      <p>
        Floating UI Plus is built on Floating UI. It brings the interaction
        layer that is especially complete in React to Web Components and Vue.
      </p>
      <div class="why-plus-points">
        <article>
          <Workflow aria-hidden="true" size={22} strokeWidth={1.7} />
          <h3>Shared interaction model</h3>
          <p>Open state, dismissal, focus, collections, nested surfaces, and portals behave consistently across frameworks.</p>
        </article>
        <article>
          <Search aria-hidden="true" size={22} strokeWidth={1.7} />
          <h3>Search beyond typeahead</h3>
          <p>Use async, cancellation-aware, multilingual fuzzy search while keeping your own input, options, and ARIA.</p>
        </article>
      </div>
    </div>
  </section>
</DemoLayout>

<script>
  type NpmPackageInfo = {
    name: string;
    version: string | null;
    description: string | null;
  };

  async function loadNpmPackages() {
    try {
      const response = await fetch('/api/npm-packages', {
        headers: {accept: 'application/json'},
      });
      if (!response.ok) return;

      const packages = (await response.json()) as NpmPackageInfo[];
      for (const pkg of packages) {
        const card = [...document.querySelectorAll<HTMLElement>('[data-npm-package]')]
          .find((element) => element.dataset.npmPackage === pkg.name);
        if (!card) continue;

        const version = card.querySelector<HTMLElement>('[data-npm-package-version]');
        if (version && pkg.version) version.textContent = `v${pkg.version}`;

        const description = card.querySelector<HTMLElement>('[data-npm-package-description]');
        if (description && pkg.description) description.textContent = pkg.description;
      }
    } catch {
      // The static npm links remain useful if the registry is unavailable.
    }
  }

  void loadNpmPackages();
</script>
