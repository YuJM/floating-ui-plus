---
import HubLayout from '../layouts/HubLayout.astro';
---

<HubLayout>
  <main class="hub">
    <span class="hub-kicker">floating-ui-plus / integrated laboratory</span>
    <h1 class="hub-title">
      One kernel.<br /><em>Two surfaces.</em>
    </h1>
    <p class="hub-intro">
      Compare two ways to build the same floating interfaces. Positioning,
      interactions, search, focus, and collections follow one shared model.
    </p>

    <section class="hub-grid" aria-label="Choose a framework demo">
      <a class="hub-card hub-card-wc" href="/web-components">
        <span class="hub-framework">01 / custom elements</span>
        <h2>Web Components</h2>
        <p>
          Custom elements for portals, trees, lists, focus management, and
          transitions.
        </p>
        <span class="hub-meta">
          <span>@floating-ui-plus/web-components</span>
          <span class="hub-arrow">Open lab ↗</span>
        </span>
      </a>

      <a class="hub-card hub-card-vue" href="/vue">
        <span class="hub-framework">02 / reactive components</span>
        <h2>Vue</h2>
        <p>
          Composition API, portals, transitions, and reactive positioning.
        </p>
        <span class="hub-meta">
          <span>@floating-ui-plus/vue</span>
          <span class="hub-arrow">Open lab ↗</span>
        </span>
      </a>
    </section>

    <footer class="hub-footer">
      <span>Positioning</span>
      <span>Interactions</span>
      <span>Accessible focus</span>
    </footer>
  </main>
</HubLayout>
