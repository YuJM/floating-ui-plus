---
import ExampleRoute from '../components/ExampleRoute.astro';
import {
  EXAMPLE_BY_ID,
  EXAMPLES,
  type ExampleId,
} from '../demo-registry';
import ClientPointExample from '../components/examples/ClientPointExample.astro';
import ComboboxExample from '../components/examples/ComboboxExample.astro';
import MenuExample from '../components/examples/MenuExample.astro';
import MiddlewareExamples from '../components/examples/MiddlewareExamples.astro';
import ModalExample from '../components/examples/ModalExample.astro';
import NestedMenuExample from '../components/examples/NestedMenuExample.astro';
import PlacementExample from '../components/examples/PlacementExample.astro';
import PopoverExample from '../components/examples/PopoverExample.astro';
import TooltipExample from '../components/examples/TooltipExample.astro';
import DemoLayout from '../layouts/DemoLayout.astro';
import ExampleView from '../vue/views/ExampleView.vue';

export function getStaticPaths() {
  return EXAMPLES.map((example) => ({
    params: {example: example.id},
    props: {example: example.id},
  }));
}

const {example} = Astro.props as {example: ExampleId};
const details = EXAMPLE_BY_ID[example];
const webExamples = {
  tooltip: TooltipExample,
  popover: PopoverExample,
  menu: MenuExample,
  'nested-menu': NestedMenuExample,
  'client-point': ClientPointExample,
  combobox: ComboboxExample,
  placement: PlacementExample,
  middleware: MiddlewareExamples,
  modal: ModalExample,
};
const WebExample = webExamples[example];
const variant = example === 'middleware' ? 'full' : example === 'placement' ? 'wide' : 'default';
---

<DemoLayout example={example}>
  <ExampleRoute
    kicker={details.label}
    heading={details.heading}
    description={details.description}
    variant={variant}
  >
    <section data-framework-panel="web-components" class="framework-panel">
      <WebExample />
    </section>
    <section data-framework-panel="vue" class="framework-panel">
      <ExampleView exampleName={example} client:only="vue">
        <p>Loading Vue example…</p>
      </ExampleView>
    </section>
  </ExampleRoute>
</DemoLayout>
