---
import LocalizedExamplePage from '../components/LocalizedExamplePage.astro';
import {EXAMPLE_IDS} from '../i18n';
export function getStaticPaths() {
  return EXAMPLE_IDS
    .filter((example) => example !== 'combobox')
    .map((example) => ({params: {example}}));
}
const {example} = Astro.params;
---
<LocalizedExamplePage locale="en" example={example as typeof EXAMPLE_IDS[number]} />
