---
import PreviewFrame from '../../components/PreviewFrame.astro';
import TooltipExample from '../../components/examples/TooltipExample.astro';
import PopoverExample from '../../components/examples/PopoverExample.astro';
import MenuExample from '../../components/examples/MenuExample.astro';
import NestedMenuExample from '../../components/examples/NestedMenuExample.astro';
import ClientPointExample from '../../components/examples/ClientPointExample.astro';
import PlacementExample from '../../components/examples/PlacementExample.astro';
import MiddlewareExamples from '../../components/examples/MiddlewareExamples.astro';
import ModalExample from '../../components/examples/ModalExample.astro';
import ExampleTooltip from '../../vue/components/ExampleTooltip.vue';
import ExamplePopover from '../../vue/components/ExamplePopover.vue';
import ExampleMenu from '../../vue/components/ExampleMenu.vue';
import ExampleNestedMenu from '../../vue/components/ExampleNestedMenu.vue';
import ExampleClientPoint from '../../vue/components/ExampleClientPoint.vue';
import PlacementView from '../../vue/views/PlacementView.vue';
import MiddlewareView from '../../vue/views/MiddlewareView.vue';
import ExampleModal from '../../vue/components/ExampleModal.vue';
import {EXAMPLE_IDS, type ExampleId} from '../../i18n';

export function getStaticPaths() {
  return EXAMPLE_IDS.filter((example) => example !== 'combobox').map((example) => ({
    params: {example},
  }));
}

const example = Astro.params.example as Exclude<ExampleId, 'combobox'>;
const labels: Record<Exclude<ExampleId, 'combobox'>, string> = {
  tooltip: 'Tooltip',
  popover: 'Popover',
  menu: 'Menu',
  'nested-menu': 'Nested menu',
  'client-point': 'Client point',
  placement: 'Placement',
  middleware: 'Middleware',
  modal: 'Modal focus room',
};
const webExamples = {
  tooltip: TooltipExample,
  popover: PopoverExample,
  menu: MenuExample,
  'nested-menu': NestedMenuExample,
  'client-point': ClientPointExample,
  placement: PlacementExample,
  middleware: MiddlewareExamples,
  modal: ModalExample,
} as const;
const WebExample = webExamples[example];
---

<PreviewFrame title={labels[example]}>
  <section data-framework-panel="web-components" class="framework-panel">
    <WebExample />
  </section>
  <section data-framework-panel="vue" class="framework-panel">
    {example === 'tooltip' && <ExampleTooltip client:only="vue" />}
    {example === 'popover' && <ExamplePopover client:only="vue" />}
    {example === 'menu' && <ExampleMenu client:only="vue" />}
    {example === 'nested-menu' && <ExampleNestedMenu client:only="vue" />}
    {example === 'client-point' && <ExampleClientPoint client:only="vue" />}
    {example === 'placement' && <PlacementView client:only="vue" />}
    {example === 'middleware' && <MiddlewareView client:only="vue" />}
    {example === 'modal' && <ExampleModal client:only="vue" />}
  </section>
</PreviewFrame>
