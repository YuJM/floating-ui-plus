---
import DemoLayout from '../../layouts/DemoLayout.astro';
import ClientPointExample from '../../components/examples/ClientPointExample.astro';
import ComboboxExample from '../../components/examples/ComboboxExample.astro';
import MenuExample from '../../components/examples/MenuExample.astro';
import ModalExample from '../../components/examples/ModalExample.astro';
import NestedMenuExample from '../../components/examples/NestedMenuExample.astro';
import PopoverExample from '../../components/examples/PopoverExample.astro';
import TooltipExample from '../../components/examples/TooltipExample.astro';
---

<DemoLayout>
  <section class="hero-stage" aria-labelledby="stage-title">
    <div class="stage-grid"></div>
    <div class="stage-copy">
      <span class="section-kicker">01 / observe</span>
      <h2 id="stage-title">The DOM is<br /><span>the API.</span></h2>
      <p>
        Every card composes Lit-powered custom elements inside Astro-rendered
        HTML. No Floating UI directive is exposed to consumers.
      </p>
    </div>
    <div class="signal-orbit" aria-hidden="true">
      <span class="orbit-ring ring-one"></span>
      <span class="orbit-ring ring-two"></span>
      <span class="orbit-dot dot-a"></span>
      <span class="orbit-dot dot-b"></span>
      <span class="orbit-dot dot-c"></span>
      <span class="orbit-core"></span>
    </div>
    <div class="stage-readout">
      <span>ROUTE MAP</span>
      <strong>/web-components/:primitive</strong>
    </div>
  </section>

  <section class="demo-grid" aria-label="Web Component interaction examples">
    <TooltipExample />
    <PopoverExample />
    <MenuExample />
    <NestedMenuExample />
    <ClientPointExample />
    <ComboboxExample />
    <a class="demo-card placement-card" href="/web-components/placement">
      <div class="card-top">
        <span class="number">P</span>
        <span class="chip">12 typed directions</span>
      </div>
      <h3>Placement constants</h3>
      <p>Choose every side and alignment without repeating string literals.</p>
      <div class="card-action">
        <span class="outline-button">Open placement lab <span>↗</span></span>
      </div>
      <code>&lt;floating-root placement="bottom-start"&gt;</code>
    </a>
  </section>

  <ModalExample />
</DemoLayout>
