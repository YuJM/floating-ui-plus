---
import VueDemoLayout from '../../../layouts/VueDemoLayout.astro';
import ExampleView from '../../../vue/views/ExampleView.vue';

type ExampleName =
  | 'tooltip'
  | 'popover'
  | 'menu'
  | 'nested-menu'
  | 'client-point'
  | 'combobox'
  | 'modal';

export function getStaticPaths() {
  const examples = [
  'tooltip',
  'popover',
  'menu',
  'nested-menu',
  'client-point',
  'combobox',
  'modal',
] as const;
  return examples.map((example) => ({
    params: {example},
    props: {example},
  }));
}

const {example} = Astro.props as {example: ExampleName};
---

<VueDemoLayout title={`${example} · Floating UI Plus Vue`}>
  <ExampleView exampleName={example} client:only="vue">
    <p slot="fallback">Loading Vue example…</p>
  </ExampleView>
</VueDemoLayout>
