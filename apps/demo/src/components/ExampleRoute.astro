---
interface Props {
  locale: import('../i18n').Locale;
  heading: string;
  description: string;
  build: string;
  features: readonly string[];
  variant?: 'default' | 'wide' | 'full';
}

import {getRelativeLocaleUrl} from 'astro:i18n';
import * as m from '../paraglide/messages';
const {heading, description, build, features, locale, variant = 'default'} = Astro.props;
const badgeTones = ['cyan', 'lavender', 'coral', 'mint', 'gold'] as const;
---

<section class:list={[
  'route-view',
  'grid grid-cols-1 gap-8 py-12 lg:grid-cols-2 lg:gap-x-20 lg:py-16',
  `route-view--${variant}`,
]}>
  <a class="back-link" href={getRelativeLocaleUrl(locale)} data-preserve-framework>← {m.back_to_patterns(undefined, {locale})}</a>
  <div class="route-copy">
    <h2>{heading}</h2>
    <p class="route-outcome">{description}</p>
    <aside class="implementation-story" aria-label={m.built_with(undefined, {locale})}>
      <div class="implementation-heading">
        <code class="implementation-package" data-framework-package>
          @floating-ui-plus/web-components
        </code>
        <span>{m.implemented_with(undefined, {locale})}</span>
      </div>
      <ul class="implementation-badges" aria-label={m.built_with(undefined, {locale})}>
        {features.map((feature, index) => (
          <li
            class:list={['implementation-badge', `implementation-badge--${badgeTones[index % badgeTones.length]}`]}
            data-badge-tone={badgeTones[index % badgeTones.length]}
          >
            <code>{feature}</code>
          </li>
        ))}
      </ul>
      <p class="implementation-summary">{build}</p>
    </aside>
  </div>
  <div class="route-stage">
    <div class="route-stage-header">
      <span>{m.live_demo(undefined, {locale})}</span>
      <span class="route-stage-rule" aria-hidden="true"></span>
      <code data-framework-name>web-components</code>
    </div>
    <slot />
  </div>
</section>
