---
import {
  NESTED_MENU_PROJECT_LABELS,
  NESTED_MENU_ROOT_LABELS,
} from '../../example-data';
---

<article class="demo-card nested-menu-card" data-demo="nested-menu">
  <div class="card-top">
    <span class="number">T</span><span class="chip">2 coordinated roots</span>
  </div>
  <h3>Nested command tree</h3>
  <p>
    Open “Move to project” with click or ArrowRight. Escape returns focus to
    its parent item.
  </p>
  <div class="card-action">
    <floating-tree>
      <floating-root data-nested-root placement="bottom-start">
        <floating-node node-id="actions">
          <floating-reference>
            <button class="dark-button">
              Open actions <span aria-hidden="true">⌄</span>
            </button>
          </floating-reference>
          <template data-fup-content data-nested-menu-content>
            <div class="menu-panel nested-menu-root">
              <div class="menu-heading">Tree coordinated actions</div>
              <button
                class="menu-item"
                role="menuitem"
                tabindex="-1"
                data-root-menu-item
                data-index="0"
                data-label={NESTED_MENU_ROOT_LABELS[0]}
              >
                <span>{NESTED_MENU_ROOT_LABELS[0]}</span><kbd>1</kbd>
              </button>
              <floating-root data-projects-root placement="right-start">
                <floating-node node-id="projects">
                  <floating-reference>
                    <button
                      class="menu-item"
                      role="menuitem"
                      tabindex="-1"
                      aria-haspopup="menu"
                      data-root-menu-item
                      data-index="1"
                      data-label={NESTED_MENU_ROOT_LABELS[1]}
                    >
                      <span>{NESTED_MENU_ROOT_LABELS[1]}</span>
                      <kbd aria-hidden="true">→</kbd>
                    </button>
                  </floating-reference>
                  <template data-fup-content data-project-menu-content>
                    <div
                      class="menu-panel nested-menu-submenu"
                      aria-label="Move to project"
                    >
                      <div class="menu-heading">Choose a project</div>
                      {
                        NESTED_MENU_PROJECT_LABELS.map((label, index) => (
                          <button
                            class="menu-item"
                            role="menuitem"
                            tabindex="-1"
                            data-project-menu-item
                            data-index={index}
                            data-label={label}
                          >
                            <span>{label}</span><kbd>{index + 1}</kbd>
                          </button>
                        ))
                      }
                    </div>
                  </template>
                </floating-node>
              </floating-root>
              <button
                class="menu-item"
                role="menuitem"
                tabindex="-1"
                data-root-menu-item
                data-index="2"
                data-label={NESTED_MENU_ROOT_LABELS[2]}
              >
                <span>{NESTED_MENU_ROOT_LABELS[2]}</span><kbd>3</kbd>
              </button>
            </div>
          </template>
        </floating-node>
      </floating-root>
    </floating-tree>
  </div>
  <code>&lt;floating-tree&gt; + &lt;floating-node&gt;</code>
</article>

<script>
  import {
    click,
    dismiss,
    flip,
    hover,
    listNavigation,
    offset,
    role,
    safePolygon,
    shift,
    typeahead,
  } from '@floating-ui-plus/web-components';
  import {
    activeItems,
    closeFloating,
    configureFloating,
    emitExampleAction,
    floatingRoot,
    floatingTemplate,
    initializeExample,
    onFloatingTemplateMount,
    onFloatingOpenChange,
  } from './example-client';

  initializeExample('nested-menu', (scope) => {
    const parent = floatingRoot(scope, '[data-nested-root]');
    const parentTemplate = floatingTemplate(
      scope,
      '[data-nested-menu-content]',
    );
    const parentItems: HTMLElement[] = [];
    const childItems: HTMLElement[] = [];
    const parentRef = {
      current: parentItems as Array<HTMLElement | null>,
    };
    const childRef = {
      current: childItems as Array<HTMLElement | null>,
    };
    const parentLabels = {
      current: [
        ...parentTemplate.content.querySelectorAll<HTMLElement>(
          '[data-root-menu-item]',
        ),
      ].map((item) => item.dataset.label ?? null),
    };
    const childLabels = {
      current: [
        ...parentTemplate.content.querySelectorAll<HTMLElement>(
          '[data-project-menu-item]',
        ),
      ].map((item) => item.dataset.label ?? null),
    };
    let child: ReturnType<typeof floatingRoot> | null = null;
    let childTrigger: HTMLElement | null = null;
    const parentActive = activeItems(
      parentItems,
      () => parent.controller.refresh(),
    );
    const childActive = activeItems(
      childItems,
      () => child?.controller.refresh(),
    );

    configureFloating(parent, {
      middleware: [offset(8), flip(), shift({padding: 18})],
      plugins: [
        click(),
        dismiss(() => ({
          escapeKey: !child?.open,
          outsidePress: (event) =>
            !(event.target instanceof Element) ||
            !event.target.closest('.nested-menu-submenu'),
        })),
        role({role: 'menu'}),
        listNavigation(() => ({
          listRef: parentRef,
          activeIndex: parentActive.value,
          loop: true,
          onNavigate: parentActive.set,
        })),
        typeahead({
          listRef: parentLabels,
          get activeIndex() {
            return parentActive.value;
          },
          onMatch: (index) => {
            parentActive.set(index);
            if (index != null) {
              parentItems[index]?.focus({preventScroll: true});
            }
          },
        }),
      ],
    });

    onFloatingTemplateMount(parentTemplate, (element) => {
      parentItems.splice(
        0,
        parentItems.length,
        ...element.querySelectorAll<HTMLElement>('[data-root-menu-item]'),
      );
      parentRef.current = parentItems;
      child = floatingRoot(element, '[data-projects-root]');
      childTrigger = parentItems[1] ?? null;
      configureFloating(child, {
        middleware: [
          offset({mainAxis: 6, alignmentAxis: -6}),
          flip(),
          shift({padding: 18}),
        ],
        plugins: [
          click(),
          hover({
            move: false,
            delay: {open: 80, close: 120},
            handleClose: safePolygon(),
          }),
          dismiss(),
          role({role: 'menu'}),
          listNavigation(() => ({
            listRef: childRef,
            activeIndex: childActive.value,
            nested: true,
            loop: true,
            onNavigate: childActive.set,
          })),
          typeahead({
            listRef: childLabels,
            get activeIndex() {
              return childActive.value;
            },
            onMatch: (index) => {
              childActive.set(index);
              if (index != null) {
                childItems[index]?.focus({preventScroll: true});
              }
            },
          }),
        ],
      });

      const childTemplate = floatingTemplate(
        element,
        '[data-project-menu-content]',
      );
      onFloatingTemplateMount(childTemplate, (childElement) => {
        childItems.splice(
          0,
          childItems.length,
          ...childElement.querySelectorAll<HTMLElement>(
            '[data-project-menu-item]',
          ),
        );
        childRef.current = childItems;
        childItems.forEach((item) => {
          item.addEventListener('click', (event) => {
            emitExampleAction(scope, `Moved to ${item.dataset.label}`);
            closeFloating(parent, event);
          });
        });
      });

      childTrigger?.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowRight' || !child) return;
        event.preventDefault();
        child.controller.context.onOpenChange(true, event, 'click');
        queueMicrotask(() => {
          childActive.set(0);
          childItems[0]?.focus({preventScroll: true});
        });
      });
      parentItems.forEach((item, index) => {
        if (index === 1) return;
        item.addEventListener('click', (event) => {
          emitExampleAction(scope, `${item.dataset.label} selected`);
          closeFloating(parent, event);
        });
      });

      onFloatingOpenChange(child, ({open, reason}) => {
        if (!open) {
          childActive.set(null);
          if (reason === 'escape-key' || reason === 'focus-out') {
            window.setTimeout(
              () => childTrigger?.focus({preventScroll: true}),
              0,
            );
          }
        }
        emitExampleAction(
          scope,
          open ? 'Project submenu opened' : 'Project submenu closed',
        );
      });
    });
    parentTemplate.addEventListener('floatingunmount', () => {
      parentRef.current = [];
      childRef.current = [];
      parentItems.splice(0);
      childItems.splice(0);
      child = null;
      childTrigger = null;
    });

    onFloatingOpenChange(parent, ({open, reason}) => {
      if (!open) {
        parentActive.set(null);
        if (child) child.open = false;
        if (reason === 'escape-key') {
          queueMicrotask(() => {
            const reference = parent.referenceElement;
            if (reference instanceof HTMLElement) {
              reference.focus({preventScroll: true});
            }
          });
        }
      }
      emitExampleAction(
        scope,
        open ? 'Nested menu opened' : 'Nested menu closed',
      );
    });
  });
</script>
