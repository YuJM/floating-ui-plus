---
import {
  NESTED_MENU_PROJECT_LABELS,
  NESTED_MENU_ROOT_LABELS,
} from '../../example-data';
---

<article class="demo-card nested-menu-card" data-demo="nested-menu">
  <div class="card-top">
    <span class="number">T</span><span class="chip">2 coordinated roots</span>
  </div>
  <h3>Nested command tree</h3>
  <p>
    Open “Move to project” with click or ArrowRight. Escape returns focus to
    its parent item.
  </p>
  <div class="card-action">
    <floating-tree>
      <floating-root data-nested-root placement="bottom-start">
        <floating-node node-id="actions">
          <floating-reference>
            <button class="dark-button">
              Open actions <span aria-hidden="true">⌄</span>
            </button>
          </floating-reference>
          <template data-fup-content data-nested-menu-content>
            <div class="menu-panel nested-menu-root">
              <div class="menu-heading">Tree coordinated actions</div>
              <floating-list
                navigation
                typeahead
                loop
                item-selector="[data-root-menu-item]"
              >
                <button
                  class="menu-item"
                  role="menuitem"
                  data-fup-close
                  data-root-menu-item
                  data-root-menu-action
                  data-label={NESTED_MENU_ROOT_LABELS[0]}
                >
                  <span>{NESTED_MENU_ROOT_LABELS[0]}</span><kbd>{NESTED_MENU_ROOT_LABELS[0].slice(0, 1).toUpperCase()}</kbd>
                </button>
                <floating-root data-projects-root placement="right-start">
                  <floating-node node-id="projects">
                    <floating-reference>
                      <button
                        class="menu-item"
                        role="menuitem"
                        aria-haspopup="menu"
                        data-root-menu-item
                        data-label={NESTED_MENU_ROOT_LABELS[1]}
                      >
                        <span>{NESTED_MENU_ROOT_LABELS[1]}</span>
                        <span class="menu-item-shortcuts"><kbd>{NESTED_MENU_ROOT_LABELS[1].slice(0, 1).toUpperCase()}</kbd><kbd aria-hidden="true">→</kbd></span>
                      </button>
                    </floating-reference>
                    <floating-list
                      navigation
                      typeahead
                      loop
                      nested
                      item-selector="[data-project-menu-item]"
                    >
                      <template data-fup-content data-project-menu-content>
                        <div
                          class="menu-panel nested-menu-submenu"
                          aria-label="Move to project"
                        >
                          <div class="menu-heading">Choose a project</div>
                          {
                            NESTED_MENU_PROJECT_LABELS.map((label) => (
                              <button
                                class="menu-item"
                                role="menuitem"
                                data-fup-close
                                data-project-menu-item
                                data-label={label}
                              >
                                <span>{label}</span><kbd>{label.slice(0, 1).toUpperCase()}</kbd>
                              </button>
                            ))
                          }
                        </div>
                      </template>
                    </floating-list>
                  </floating-node>
                </floating-root>
                <button
                  class="menu-item"
                  role="menuitem"
                  data-fup-close
                  data-root-menu-item
                  data-root-menu-action
                  data-label={NESTED_MENU_ROOT_LABELS[2]}
                >
                  <span>{NESTED_MENU_ROOT_LABELS[2]}</span><kbd>{NESTED_MENU_ROOT_LABELS[2].slice(0, 1).toUpperCase()}</kbd>
                </button>
              </floating-list>
            </div>
          </template>
        </floating-node>
      </floating-root>
    </floating-tree>
  </div>
  <code>&lt;floating-tree&gt; + &lt;floating-node&gt;</code>
</article>

<script>
  import {
    click,
    dismiss,
    flip,
    hover,
    offset,
    role,
    safePolygon,
    shift,
  } from '@floating-ui-plus/web-components';
  import {
    closeFloating,
    configureFloating,
    emitExampleAction,
    floatingRoot,
    floatingTemplate,
    initializeExample,
    onFloatingTemplateMount,
    onFloatingOpenChange,
  } from './example-client';

  initializeExample('nested-menu', (scope) => {
    const parent = floatingRoot(scope, '[data-nested-root]');
    const parentTemplate = floatingTemplate(
      scope,
      '[data-nested-menu-content]',
    );
    let child: ReturnType<typeof floatingRoot> | null = null;

    configureFloating(parent, {
      middleware: [offset(8), flip(), shift({padding: 18})],
      plugins: [
        click(),
        dismiss(() => ({
          escapeKey: !child?.open,
          outsidePress: (event) =>
            !(event.target instanceof Element) ||
            !event.target.closest('.nested-menu-submenu'),
        })),
        role({role: 'menu'}),
      ],
    });

    onFloatingTemplateMount(parentTemplate, (element) => {
      child = floatingRoot(element, '[data-projects-root]');
      configureFloating(child, {
        middleware: [
          offset({mainAxis: 6, alignmentAxis: -6}),
          flip(),
          shift({padding: 18}),
        ],
        plugins: [
          click(),
          hover({
            move: false,
            delay: {open: 80, close: 120},
            handleClose: safePolygon(),
          }),
          dismiss(),
          role({role: 'menu'}),
        ],
      });

      const childTemplate = floatingTemplate(
        element,
        '[data-project-menu-content]',
      );
      onFloatingTemplateMount(childTemplate, (childElement) => {
        childElement.addEventListener('click', (event) => {
          if (!(event.target instanceof Element)) return;
          const item = event.target.closest<HTMLElement>(
            '[data-project-menu-item]',
          );
          if (!item || !childElement.contains(item)) return;
          emitExampleAction(scope, `Moved to ${item.dataset.label}`);
          closeFloating(parent, event);
        });
      });

      element.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;
        const item = event.target.closest<HTMLElement>(
          '[data-root-menu-action]',
        );
        if (!item || !element.contains(item)) return;
        emitExampleAction(scope, `${item.dataset.label} selected`);
      });

      onFloatingOpenChange(child, ({open, reason}) => {
        if (!open) {
          if (reason === 'escape-key' || reason === 'focus-out') {
            window.setTimeout(() => {
              const reference = child?.referenceElement;
              if (reference instanceof HTMLElement) {
                reference.focus({preventScroll: true});
              }
            }, 0);
          }
        }
        emitExampleAction(
          scope,
          open ? 'Project submenu opened' : 'Project submenu closed',
        );
      });
    });

    onFloatingOpenChange(parent, ({open, reason}) => {
      if (!open) {
        if (child) child.open = false;
        if (reason === 'escape-key') {
          queueMicrotask(() => {
            const reference = parent.referenceElement;
            if (reference instanceof HTMLElement) {
              reference.focus({preventScroll: true});
            }
          });
        }
      }
      emitExampleAction(
        scope,
        open ? 'Nested menu opened' : 'Nested menu closed',
      );
    });
  });
</script>
