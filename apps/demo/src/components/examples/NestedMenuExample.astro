---
const rootLabels = ['New note', 'Move to project', 'Archive'];
const projectLabels = ['Atlas', 'Field research', 'Signals'];
---

<article class="demo-card nested-menu-card" data-demo="nested-menu">
  <div class="card-top">
    <span class="number">T</span><span class="chip">2 coordinated roots</span>
  </div>
  <h3>Nested command tree</h3>
  <p>
    Open “Move to project” with click or ArrowRight. Escape returns focus to
    its parent item.
  </p>
  <div class="card-action">
    <floating-tree>
      <floating-root data-nested-root placement="bottom-start">
        <floating-node node-id="actions">
          <floating-reference>
            <button class="dark-button">
              Open actions <span aria-hidden="true">⌄</span>
            </button>
          </floating-reference>
          <floating-content>
            <div class="menu-panel nested-menu-root">
              <div class="menu-heading">Tree coordinated actions</div>
              <button
                class="menu-item"
                role="menuitem"
                tabindex="-1"
                data-root-menu-item
                data-index="0"
                data-label={rootLabels[0]}
              >
                <span>{rootLabels[0]}</span><kbd>1</kbd>
              </button>
              <floating-root data-projects-root placement="right-start">
                <floating-node node-id="projects">
                  <floating-reference>
                    <button
                      class="menu-item"
                      role="menuitem"
                      tabindex="-1"
                      aria-haspopup="menu"
                      data-root-menu-item
                      data-index="1"
                      data-label={rootLabels[1]}
                    >
                      <span>{rootLabels[1]}</span>
                      <kbd aria-hidden="true">→</kbd>
                    </button>
                  </floating-reference>
                  <floating-content>
                    <div
                      class="menu-panel nested-menu-submenu"
                      aria-label="Move to project"
                    >
                      <div class="menu-heading">Choose a project</div>
                      {
                        projectLabels.map((label, index) => (
                          <button
                            class="menu-item"
                            role="menuitem"
                            tabindex="-1"
                            data-project-menu-item
                            data-index={index}
                            data-label={label}
                          >
                            <span>{label}</span><kbd>{index + 1}</kbd>
                          </button>
                        ))
                      }
                    </div>
                  </floating-content>
                </floating-node>
              </floating-root>
              <button
                class="menu-item"
                role="menuitem"
                tabindex="-1"
                data-root-menu-item
                data-index="2"
                data-label={rootLabels[2]}
              >
                <span>{rootLabels[2]}</span><kbd>3</kbd>
              </button>
            </div>
          </floating-content>
        </floating-node>
      </floating-root>
    </floating-tree>
  </div>
  <code>&lt;floating-tree&gt; + &lt;floating-node&gt;</code>
</article>
