---
import {
  getMiddlewareExample,
  type MiddlewareExampleId,
} from '../../middleware-registry';

interface Props {
  id: MiddlewareExampleId;
}

const example = getMiddlewareExample(Astro.props.id);
---

<div class="middleware-title">
  <span>{example.number}</span>
  <h3>{example.title}</h3>
  <a
    href={`https://floating-ui.com/docs/${example.docsPath}`}
    target="_blank"
    rel="noreferrer"
    aria-label={`${example.title} middleware official documentation`}
  >
    (DOC)
  </a>
</div>
