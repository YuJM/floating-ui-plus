---
import {multilingualSearchPrompts} from '../../multilingual-destinations';
import AsyncComboboxExample from './AsyncComboboxExample.astro';
---

<div class="combobox-examples">
  <article class="demo-card combobox-card" data-demo="combobox">
  <div class="card-top">
    <span class="number">F</span>
    <span class="chip">framework-neutral search</span>
  </div>
  <h3>Multilingual combobox</h3>
  <p>Search by city, country, local script, alias, or forgiving typo.</p>

  <div class="combobox-shell">
    <label class="combobox-label" for="destination-search">
      Destination
    </label>
    <floating-root data-combobox-root placement="bottom-start">
      <floating-list navigation loop allow-escape>
        <floating-combobox
          data-combobox
          option-id-prefix="destination-option"
        >
          <floating-reference>
            <input
              id="destination-search"
              class="combobox-input"
              type="text"
              autocomplete="off"
              spellcheck="false"
              aria-describedby="combobox-hints combobox-status"
              placeholder="Search city or country…"
            />
          </floating-reference>
          <floating-portal>
            <template slot="content" data-combobox-content>
              <div
                class="combobox-popup"
                data-combobox-popup
                aria-label="Destination suggestions"
              >
                <floating-search>
                  <template data-search-loading>
                    <div
                      class="combobox-empty"
                      role="option"
                      aria-disabled="true"
                    >
                      Searching…
                    </div>
                  </template>
                  <template data-search-error>
                    <div
                      class="combobox-empty"
                      role="option"
                      aria-disabled="true"
                    >
                      Search failed.
                    </div>
                  </template>
                  <template data-search-empty>
                    <div
                      class="combobox-empty"
                      role="option"
                      aria-disabled="true"
                    >
                      No destination found for “<span
                        data-search-text="$query"
                      ></span>”
                    </div>
                  </template>
                  <template data-search-result>
                    <floating-list-item>
                      <div class="combobox-option">
                        <span>
                          <strong data-search-text="label"></strong>
                          <small data-search-text="region"></small>
                        </span>
                        <span
                          class="language-badge"
                          data-search-text="language"
                        ></span>
                      </div>
                    </floating-list-item>
                  </template>
                </floating-search>
              </div>
            </template>
          </floating-portal>
          <p
            id="combobox-status"
            class="sr-only"
            aria-live="polite"
            data-combobox-status
          >
            Destination suggestions closed
          </p>
        </floating-combobox>
      </floating-list>
    </floating-root>
    <span class="combobox-icon" aria-hidden="true">⌕</span>
  </div>

  <div id="combobox-hints" class="combobox-hints">
    {
      multilingualSearchPrompts.map(([sample, destination]) => (
        <button type="button" data-search-sample={sample}>
          <code>{sample}</code><span>→ {destination}</span>
        </button>
      ))
    }
  </div>

  <code>
    &lt;floating-combobox&gt; + &lt;floating-search&gt; +
    &lt;floating-list-item&gt;
  </code>
  </article>

  <AsyncComboboxExample />
</div>

<script>
  import {
    createFuzzySearchSource,
    dismiss,
    flip,
    offset,
    shift,
    type FloatingComboboxElement,
    type FloatingComboboxSelectDetail,
  } from '@floating-ui-plus/web-components';
  import {
    multilingualDestinations,
    multilingualSearchKeys,
    type MultilingualDestination,
  } from '../../multilingual-destinations';
  import {
    emitExampleAction,
    initializeExample,
  } from './example-client';

  initializeExample('combobox', (scope) => {
    const floating = scope.querySelector('floating-root');
    const combobox = scope.querySelector<FloatingComboboxElement>(
      '[data-combobox]',
    );
    if (!floating || !combobox) return;

    combobox.configure<MultilingualDestination>({
      search: {
        source: createFuzzySearchSource(multilingualDestinations, {
          keys: multilingualSearchKeys,
          threshold: 0.35,
        }),
        getItemKey: (item) => item.id,
        debounceMs: 0,
      },
      getItemLabel: (item) => item.label,
      status: {
        closed: 'Destination suggestions closed',
        selected: (item) => `${item.label} selected`,
        idle: 'Start typing to search',
        loading: 'Searching destinations',
        error: 'Destination search failed',
        empty: ({search: state}) =>
          `No destinations found for ${state.query}`,
        results: ({search: state}) =>
          `${state.items.length} destinations available`,
      },
    });

    floating.configure({
      middleware: [offset(8), flip(), shift({padding: 18})],
      plugins: [dismiss()],
    });

    combobox.addEventListener('comboboxselect', (event) => {
      const {item} = (event as CustomEvent<FloatingComboboxSelectDetail>)
        .detail;
      emitExampleAction(
        scope,
        `${(item as MultilingualDestination).label} selected`,
      );
    });
    const input = scope.querySelector<HTMLInputElement>('#destination-search');
    scope
      .querySelectorAll<HTMLButtonElement>('[data-search-sample]')
      .forEach((button) => {
        button.addEventListener('mousedown', (event) => event.preventDefault());
        button.addEventListener('click', (event) => {
          combobox.setQuery(button.dataset.searchSample ?? '', event);
          input?.focus({preventScroll: true});
        });
      });
  });
</script>
