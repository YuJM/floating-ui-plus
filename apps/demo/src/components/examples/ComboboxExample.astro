---
import {multilingualSearchPrompts} from '../../multilingual-destinations';
import type {ComboboxSource} from '../../i18n';
import AsyncComboboxExample from './AsyncComboboxExample.astro';

const {source = 'fuzzy'} = Astro.props as {source?: ComboboxSource};
const sourceHref = (nextSource: ComboboxSource) => {
  const url = new URL(Astro.url);
  url.searchParams.set('source', nextSource);
  return `${url.pathname}${url.search}`;
};
---

<div class="combobox-examples">
  <article class="demo-card combobox-card">
  <div class="card-top">
    <span class="number">F</span>
    <span class="chip">search sources</span>
  </div>
  <div class="combobox-tabs" role="tablist" aria-label="Combobox search source" data-combobox-tabs>
    <a
      id="combobox-tab-local"
      href={sourceHref('fuzzy')}
      data-combobox-source="fuzzy"
      role="tab"
      aria-selected={source === 'fuzzy' ? 'true' : 'false'}
      aria-controls="combobox-panel-local"
      tabindex={source === 'fuzzy' ? undefined : '-1'}
    >
      Fuzzy search
    </a>
    <a
      id="combobox-tab-server"
      href={sourceHref('server')}
      data-combobox-source="server"
      role="tab"
      aria-selected={source === 'server' ? 'true' : 'false'}
      aria-controls="combobox-panel-server"
      tabindex={source === 'server' ? undefined : '-1'}
    >
      Server search
    </a>
  </div>
  <section
    class="combobox-panel"
    data-demo="combobox"
    id="combobox-panel-local"
    role="tabpanel"
    aria-labelledby="combobox-tab-local"
    hidden={source !== 'fuzzy'}
  >
  <h3>Multilingual combobox</h3>
  <p>Search by city, country, local script, alias, or forgiving typo.</p>

  <div class="combobox-shell">
    <label class="combobox-label" for="destination-search">
      Destination
    </label>
    <floating-root data-combobox-root placement="bottom-start">
      <floating-list navigation loop allow-escape>
        <floating-combobox
          data-combobox
          option-id-prefix="destination-option"
          query-trigger-selector="#combobox-hints [data-search-sample]"
        >
          <floating-reference>
            <input
              id="destination-search"
              class="combobox-input"
              type="text"
              autocomplete="off"
              spellcheck="false"
              aria-describedby="combobox-hints combobox-status"
              placeholder="Search city or country…"
            />
          </floating-reference>
          <template slot="content" data-combobox-content>
              <div
                class="combobox-popup"
                data-combobox-popup
                aria-label="Destination suggestions"
              >
                <floating-search>
                  <template data-search-loading>
                    <div
                      class="combobox-empty"
                      role="option"
                      aria-disabled="true"
                    >
                      Searching…
                    </div>
                  </template>
                  <template data-search-error>
                    <div
                      class="combobox-empty"
                      role="option"
                      aria-disabled="true"
                    >
                      Search failed.
                    </div>
                  </template>
                  <template data-search-empty>
                    <div
                      class="combobox-empty"
                      role="option"
                      aria-disabled="true"
                    >
                      No destination found for “<span
                        data-search-text="$query"
                      ></span>”
                    </div>
                  </template>
                  <template data-search-result>
                    <floating-list-item>
                      <div class="combobox-option">
                        <span>
                          <strong data-search-text="label"></strong>
                          <small data-search-text="region"></small>
                        </span>
                        <span
                          class="language-badge"
                          data-search-text="language"
                        ></span>
                      </div>
                    </floating-list-item>
                  </template>
                </floating-search>
              </div>
          </template>
          <p
            id="combobox-status"
            class="sr-only"
            aria-live="polite"
            data-combobox-status
          >
            Destination suggestions closed
          </p>
        </floating-combobox>
      </floating-list>
    </floating-root>
    <span class="combobox-icon" aria-hidden="true">⌕</span>
  </div>

  <div id="combobox-hints" class="combobox-hints">
    {
      multilingualSearchPrompts.map(([sample, destination]) => (
        <button type="button" value={sample} data-search-sample={sample}>
          <code>{sample}</code><span>→ {destination}</span>
        </button>
      ))
    }
  </div>

  <code>
    &lt;floating-combobox&gt; + &lt;floating-search&gt; +
    &lt;floating-list-item&gt;
  </code>
  </section>

  <AsyncComboboxExample hidden={source !== 'server'} />
  </article>
</div>

<script>
  import {
    FloatingRootElement,
    createFuzzySearchSource,
    dismiss,
    flip,
    offset,
    shift,
    type FloatingComboboxElement,
  } from '@floating-ui-plus/web-components';
  import {
    multilingualDestinations,
    multilingualSearchKeys,
    type MultilingualDestination,
  } from '../../multilingual-destinations';
  import {initializeExample} from './initialize-example';

  initializeExample('combobox', (scope) => {
    const floating = FloatingRootElement.query(
      scope,
      '[data-combobox-root]',
    );
    const combobox = scope.querySelector<FloatingComboboxElement>(
      '[data-combobox]',
    );
    if (!combobox) return;

    combobox.configure<MultilingualDestination>({
      search: {
        source: createFuzzySearchSource(multilingualDestinations, {
          keys: multilingualSearchKeys,
          threshold: 0.35,
        }),
        getItemKey: (item) => item.id,
        debounceMs: 0,
      },
      getItemLabel: (item) => item.label,
      status: {
        closed: 'Destination suggestions closed',
        selected: (item) => `${item.label} selected`,
        idle: 'Start typing to search',
        loading: 'Searching destinations',
        error: 'Destination search failed',
        empty: ({search: state}) =>
          `No destinations found for ${state.query}`,
        results: ({search: state}) =>
          `${state.items.length} destinations available`,
      },
    });

    floating.configure({
      middleware: [offset(8), flip(), shift({padding: 18})],
      plugins: [dismiss()],
    });

  });

  document.querySelectorAll<HTMLElement>('[data-combobox-tabs]').forEach(
    (tablist) => {
      const tabs = Array.from(
        tablist.querySelectorAll<HTMLAnchorElement>('[role="tab"]'),
      );
      tabs.forEach((tab) => {
        const source = tab.dataset.comboboxSource;
        if (!source) return;
        const url = new URL(window.location.href);
        url.searchParams.set('source', source);
        tab.href = `${url.pathname}${url.search}`;
      });
      const card = tablist.closest<HTMLElement>('.combobox-card');
      const panels = tabs.map((tab) => {
        const panelId = tab.getAttribute('aria-controls');
        return panelId ? card?.querySelector<HTMLElement>(`#${panelId}`) : null;
      });

      const selectTab = (selectedIndex: number, focus = false) => {
        tabs.forEach((tab, index) => {
          const selected = index === selectedIndex;
          tab.setAttribute('aria-selected', String(selected));
          tab.tabIndex = selected ? 0 : -1;
          panels[index]?.toggleAttribute('hidden', !selected);
        });
        if (focus) tabs[selectedIndex]?.focus();
      };

      const requestedSource = new URLSearchParams(window.location.search).get('source');
      selectTab(
        requestedSource === 'server'
          ? 1
          : requestedSource === 'fuzzy'
            ? 0
            : Math.max(0, tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true')),
      );

      tabs.forEach((tab, index) => {
        tab.addEventListener('keydown', (event) => {
          if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
          event.preventDefault();
          const direction = event.key === 'ArrowRight' ? 1 : -1;
          const next = tabs[(index + direction + tabs.length) % tabs.length];
          if (next) window.location.assign(next.href);
        });
      });
    },
  );

</script>
