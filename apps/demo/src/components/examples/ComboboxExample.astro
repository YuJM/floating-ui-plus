---
import {multilingualSearchPrompts} from '../../multilingual-destinations';
---

<article class="demo-card combobox-card" data-demo="combobox">
  <div class="card-top">
    <span class="number">F</span>
    <span class="chip">framework-neutral search</span>
  </div>
  <h3>Multilingual combobox</h3>
  <p>Search by city, country, local script, alias, or forgiving typo.</p>

  <div class="combobox-shell">
    <label class="combobox-label" for="destination-search">
      Destination
    </label>
    <floating-root data-combobox-root placement="bottom-start">
      <floating-list navigation loop allow-escape>
        <floating-combobox
          data-combobox
          option-id-prefix="destination-option"
        >
          <floating-reference>
            <input
              id="destination-search"
              class="combobox-input"
              type="text"
              autocomplete="off"
              spellcheck="false"
              aria-describedby="combobox-hints combobox-status"
              placeholder="Search city or country…"
            />
          </floating-reference>
          <floating-portal>
            <template data-combobox-content>
              <div
                class="combobox-popup"
                data-combobox-popup
                aria-label="Destination suggestions"
              ></div>
            </template>
          </floating-portal>
        </floating-combobox>
      </floating-list>
    </floating-root>
    <span class="combobox-icon" aria-hidden="true">⌕</span>
  </div>

  <div id="combobox-hints" class="combobox-hints">
    {
      multilingualSearchPrompts.map(([sample, destination]) => (
        <button type="button" data-search-sample={sample}>
          <code>{sample}</code><span>→ {destination}</span>
        </button>
      ))
    }
  </div>
  <p id="combobox-status" class="sr-only" aria-live="polite">
    Destination suggestions closed
  </p>
  <code>
    &lt;floating-combobox&gt; + &lt;floating-list&gt; +
    &lt;floating-list-item&gt;
  </code>
</article>

<script>
  import {
    SearchController,
    createFuzzySearchSource,
    dismiss,
    flip,
    offset,
    shift,
    type FloatingComboboxElement,
    type FloatingComboboxSelectDetail,
  } from '@floating-ui-plus/web-components';
  import {
    multilingualDestinations,
    multilingualSearchKeys,
    type MultilingualDestination,
  } from '../../multilingual-destinations';
  import {
    configureFloating,
    emitExampleAction,
    floatingRoot,
    floatingTemplate,
    initializeExample,
    onFloatingTemplateMount,
    onFloatingOpenChange,
  } from './example-client';

  function createEmptyOption(message: string) {
    const element = document.createElement('div');
    element.className = 'combobox-empty';
    element.role = 'option';
    element.setAttribute('aria-disabled', 'true');
    element.textContent = message;
    return element;
  }

  initializeExample('combobox', (scope) => {
    const floating = floatingRoot(scope, '[data-combobox-root]');
    const template = floatingTemplate(scope, '[data-combobox-content]');
    const combobox = scope.querySelector<FloatingComboboxElement>(
      '[data-combobox]',
    );
    const input =
      scope.querySelector<HTMLInputElement>('#destination-search');
    const status = scope.querySelector<HTMLElement>('#combobox-status');
    if (!combobox || !input || !status) return;
    let popup: HTMLElement | null = null;
    let renderedResultsKey: string | null = null;

    const source = createFuzzySearchSource(multilingualDestinations, {
      keys: multilingualSearchKeys,
      threshold: 0.35,
    });
    const search = new SearchController<MultilingualDestination>({
      source,
      getItemKey: (item) => item.id,
      debounceMs: 0,
    });
    combobox.search = search as SearchController<unknown>;
    const render = () => {
      const currentPopup = popup;
      if (!currentPopup) return;
      const resultsKey = search.loading
        ? 'loading'
        : search.error
          ? 'error'
          : search.items.length
            ? search.items.map((item) => item.id).join(':')
            : `empty:${search.query}`;
      if (resultsKey !== renderedResultsKey) {
        renderedResultsKey = resultsKey;
        currentPopup.replaceChildren();
        if (search.loading) {
          currentPopup.append(createEmptyOption('Searching…'));
        } else if (search.error) {
          currentPopup.append(createEmptyOption('Search failed.'));
        } else if (!search.items.length) {
          currentPopup.append(
            createEmptyOption(`No destination found for “${search.query}”`),
          );
        } else {
          search.items.forEach((item) => {
            const listItem = document.createElement('floating-list-item');
            listItem.label = item.label;
            listItem.value = item;
            const option = document.createElement('div');
            option.className = 'combobox-option';
            option.innerHTML =
              `<span><strong>${item.label}</strong><small>${item.region}</small></span>` +
              `<span class="language-badge">${item.language}</span>`;
            listItem.append(option);
            currentPopup.append(listItem);
          });
        }
      }
      const selected =
        combobox.selectedItem as MultilingualDestination | null;
      status.textContent = floating.open
        ? search.items.length
          ? `${search.items.length} destinations available`
          : `No destinations found for ${search.query}`
        : selected
          ? `${selected.label} selected`
          : 'Destination suggestions closed';
      floating.controller.refresh();
    };

    configureFloating(floating, {
      middleware: [offset(8), flip(), shift({padding: 18})],
      plugins: [dismiss()],
    });

    onFloatingTemplateMount(template, (element) => {
      popup = element.matches('[data-combobox-popup]')
        ? element
        : element.querySelector<HTMLElement>('[data-combobox-popup]');
      renderedResultsKey = null;
      render();
    });
    combobox.addEventListener('comboboxstatechange', render);
    combobox.addEventListener('comboboxselect', (event) => {
      const {item} = (event as CustomEvent<FloatingComboboxSelectDetail>)
        .detail;
      emitExampleAction(
        scope,
        `${(item as MultilingualDestination).label} selected`,
      );
    });
    scope
      .querySelectorAll<HTMLElement>('[data-search-sample]')
      .forEach((button) => {
        button.addEventListener('click', () => {
          input.value = button.dataset.searchSample ?? '';
          combobox.setQuery(input.value);
          input.focus();
        });
      });
    onFloatingOpenChange(floating, render);
  });
</script>
