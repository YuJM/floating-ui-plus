<section class="modal-demo" aria-label="Modal focus management example" data-demo="modal">
  <p>Open the focus room to test focus trapping, inert neighbors, and layered Escape dismissal.</p>
  <floating-tree>
    <floating-root data-modal-root placement="bottom">
      <floating-node node-id="focus-room">
        <floating-reference>
          <button class="outline-button">
            Enter focus room <span aria-hidden="true">→</span>
          </button>
        </floating-reference>
        <floating-portal>
          <floating-overlay class="demo-overlay" lock-scroll>
            <floating-focus-manager
              modal
              return-focus
              outside-elements-inert
            >
              <floating-content class="modal-anchor" data-modal-content>
                <template>
                  <section
                    class="modal-panel"
                    aria-label="Focus room"
                    aria-labelledby="modal-heading"
                  >
                  <span class="panel-kicker">FOCUS ROOM / PRIVATE</span>
                  <h3 id="modal-heading">You are inside<br />the focus trap.</h3>
                  <p>
                    Nested surfaces keep their own dismissal step. Escape
                    closes the topmost surface before this room.
                  </p>
                  <div class="modal-nested-actions">
                    <floating-root
                      data-modal-tooltip-root
                      interactions="hover focus dismiss"
                      floating-role="tooltip"
                      placement="top"
                    >
                      <floating-node node-id="focus-room-tooltip">
                        <floating-reference>
                          <button class="text-button">Show placement hint</button>
                        </floating-reference>
                        <floating-content>
                          <div class="tooltip">
                            This tooltip stays inside the dialog.
                          </div>
                        </floating-content>
                      </floating-node>
                    </floating-root>
                    <floating-root
                      data-modal-popover-root
                      interactions="click dismiss"
                      floating-role="dialog"
                      placement="bottom-start"
                    >
                      <floating-node node-id="focus-room-popover">
                        <floating-reference>
                          <button class="text-button">Open room details</button>
                        </floating-reference>
                        <floating-portal>
                          <floating-content data-modal-popover-content>
                            <template>
                              <section
                                class="popover-panel"
                                aria-label="Room details"
                              >
                                <span class="panel-kicker">NESTED PORTAL</span>
                                <strong>Details stay above the dialog.</strong>
                                <p>Escape and outside press dismiss only this panel first.</p>
                                <button class="text-button" data-close-modal-popover>
                                  Close details
                                </button>
                              </section>
                            </template>
                          </floating-content>
                        </floating-portal>
                      </floating-node>
                    </floating-root>
                    <floating-root data-nested-modal-root placement="bottom">
                      <floating-node node-id="focus-room-child-dialog">
                        <floating-reference>
                          <button class="text-button">Open nested dialog</button>
                        </floating-reference>
                        <floating-portal>
                          <floating-overlay class="demo-overlay" lock-scroll>
                            <floating-focus-manager modal return-focus>
                              <floating-content
                                class="modal-anchor"
                                data-nested-modal-content
                              >
                                <template>
                                  <section
                                    class="modal-panel nested-modal-panel"
                                    aria-label="Nested dialog"
                                  >
                                    <span class="panel-kicker">SECOND LAYER</span>
                                    <h3>One more<br />focus boundary.</h3>
                                    <p>Close this layer to resume the parent dialog.</p>
                                    <button class="coral-button" data-close-nested-modal>
                                      Return to focus room
                                    </button>
                                  </section>
                                </template>
                              </floating-content>
                            </floating-focus-manager>
                          </floating-overlay>
                        </floating-portal>
                      </floating-node>
                    </floating-root>
                  </div>
                  <div class="modal-actions">
                    <button class="coral-button" data-close-modal>Leave room</button>
                    <span class="modal-hint">ESC closes the top layer</span>
                  </div>
                  </section>
                </template>
              </floating-content>
            </floating-focus-manager>
          </floating-overlay>
        </floating-portal>
      </floating-node>
    </floating-root>
  </floating-tree>
</section>

<script>
  import {
    click,
    dismiss,
    flip,
    offset,
    role,
    shift,
  } from '@floating-ui-plus/web-components';
  import {
    closeFloating,
    configureFloating,
    emitExampleAction,
    floatingContent,
    floatingRoot,
    initializeExample,
    onFloatingContentMount,
    onFloatingOpenChange,
  } from './example-client';

  initializeExample('modal', (scope) => {
    const floating = floatingRoot(scope, '[data-modal-root]');
    const content = floatingContent(scope, '[data-modal-content]');

    configureFloating(floating, {
      middleware: [offset(20), shift({padding: 24})],
      plugins: [
        click(),
        // The backdrop owns the whole viewport. Nested surfaces dismiss first.
        dismiss({outsidePress: false}),
        role({role: 'dialog'}),
      ],
    });
    onFloatingContentMount(content, () => {
      const tooltip = floatingRoot(content, '[data-modal-tooltip-root]');
      const popover = floatingRoot(content, '[data-modal-popover-root]');
      const nestedModal = floatingRoot(content, '[data-nested-modal-root]');
      tooltip.middleware = [offset(12), flip(), shift({padding: 12})];
      popover.middleware = [offset(12), flip(), shift({padding: 18})];
      configureFloating(nestedModal, {
        middleware: [offset(20), shift({padding: 24})],
        plugins: [
          click(),
          dismiss({outsidePress: false}),
          role({role: 'dialog'}),
        ],
      });
      const popoverContent = floatingContent(
        content,
        '[data-modal-popover-content]',
      );
      const nestedModalContent = floatingContent(
        content,
        '[data-nested-modal-content]',
      );
      popoverContent.addEventListener('click', (event) => {
        if (
          event.target instanceof Element &&
          event.target.closest('[data-close-modal-popover]')
        ) {
          closeFloating(popover, event);
        }
      });
      nestedModalContent.addEventListener('click', (event) => {
        if (
          event.target instanceof Element &&
          event.target.closest('[data-close-nested-modal]')
        ) {
          closeFloating(nestedModal, event);
        }
      });
    });

    content.addEventListener('click', (event) => {
      if (
        event.target instanceof Element &&
        event.target.closest('[data-close-modal]')
      ) {
        closeFloating(floating, event);
      }
    });
    onFloatingOpenChange(floating, ({open}) => {
      emitExampleAction(
        scope,
        open ? 'Modal trap activated' : 'Modal closed and focus restored',
      );
    });
  });
</script>
