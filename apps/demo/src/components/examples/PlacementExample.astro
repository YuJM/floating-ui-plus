---
import {DEFAULT_PLACEMENT, PLACEMENT_OPTIONS} from '../../example-data';
---

<div class="placement-stage" aria-label="Interactive placement selector" data-demo="placement">
    {
      PLACEMENT_OPTIONS.map((placement) => (
        <button
          type="button"
          class:list={[
            'placement-control',
            {'is-selected': placement === DEFAULT_PLACEMENT},
          ]}
          data-placement-control={placement}
          aria-pressed={placement === DEFAULT_PLACEMENT}
          aria-label={`Place floating element at ${placement}`}
        >
          <span aria-hidden="true"></span>
        </button>
      ))
    }
    <floating-root data-placement-root open placement={DEFAULT_PLACEMENT}>
      <div slot="reference" class="placement-reference">Reference</div>
      <div slot="floating" class="placement-floating" role="status">{DEFAULT_PLACEMENT}</div>
    </floating-root>
</div>
