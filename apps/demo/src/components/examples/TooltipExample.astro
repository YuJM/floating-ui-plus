---
import {TOOLTIP_ARROW} from '../../example-config';
---

<article class="demo-card tooltip-card" data-demo="tooltip">
  <div class="card-top">
    <span class="number">A</span><span class="chip">hover + focus</span>
  </div>
  <h3>Signal tooltip</h3>
  <p>
    One floating surface wires pointer intent, keyboard focus, dismissal, and
    descriptive ARIA.
  </p>
  <div class="card-action">
    <floating-root
      data-tooltip-root
      placement="top"
    >
      <floating-reference>
        <button class="ink-button">
          Inspect signal <span aria-hidden="true">↗</span>
        </button>
      </floating-reference>
      <floating-transition>
        <floating-content>
            <div class="tooltip">
              Positioned by <b>autoUpdate</b>
              <floating-arrow
                class="tooltip-arrow"
                width={TOOLTIP_ARROW.width}
                height={TOOLTIP_ARROW.height}
              ></floating-arrow>
            </div>
        </floating-content>
      </floating-transition>
    </floating-root>
  </div>
  <code>hover() → focus() → dismiss()</code>
</article>

<script>
  import {
    arrow,
    dismiss,
    flip,
    focus,
    hover,
    offset,
    role,
    safePolygon,
    shift,
  } from '@floating-ui-plus/web-components';
  import {TOOLTIP_ARROW} from '../../example-config';
  import {
    configureFloating,
    emitExampleAction,
    floatingRoot,
    initializeExample,
    onFloatingOpenChange,
  } from './example-client';

  initializeExample('tooltip', (scope) => {
    const floating = floatingRoot(scope, '[data-tooltip-root]');
    const arrowElement =
      floating.querySelector<HTMLElement>('floating-arrow');
    configureFloating(floating, {
      middleware: [
        offset(TOOLTIP_ARROW.gap),
        flip(),
        shift({padding: 12}),
        ...(arrowElement ? [arrow({element: arrowElement})] : []),
      ],
      plugins: [
        hover({handleClose: safePolygon({buffer: 4})}),
        focus(),
        dismiss(),
        role({role: 'tooltip'}),
      ],
    });
    onFloatingOpenChange(floating, ({open}) => {
      emitExampleAction(
        scope,
        open ? 'Tooltip opened from pointer or focus' : 'Tooltip closed',
      );
    });
  });
</script>
