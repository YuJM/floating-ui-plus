---
import {MENU_LABELS} from '../../example-data';
---

<article class="demo-card menu-card" data-demo="menu">
  <div class="card-top">
    <span class="number">C</span><span class="chip">roving focus</span>
  </div>
  <h3>Command menu</h3>
  <p>
    Arrow keys, looping, and typeahead share one list registry. Try typing
    “signal”.
  </p>
  <div class="card-action">
    <floating-root
      data-menu-root
      interactions="click dismiss"
      floating-role="menu"
      placement="bottom-start"
    >
      <floating-reference>
        <button class="dark-button">
          Open navigator <span aria-hidden="true">⌄</span>
        </button>
      </floating-reference>
      <floating-portal>
        <template data-menu-content>
          <div class="menu-panel">
            <div class="menu-heading">Jump to a field</div>
            <floating-list
              navigation
              typeahead
              loop
              item-selector="[data-menu-item]"
            >
              {
                MENU_LABELS.map((label, index) => (
                  <button
                    class="menu-item"
                    role="menuitem"
                    data-fup-close
                    data-menu-item
                    data-index={index}
                    data-label={label}
                  >
                    <span>{label}</span><kbd>{index + 1}</kbd>
                  </button>
                ))
              }
            </floating-list>
          </div>
        </template>
      </floating-portal>
    </floating-root>
  </div>
  <code>&lt;floating-list navigation typeahead item-selector="…" /&gt;</code>
</article>

<script>
  import {
    flip,
    offset,
    shift,
  } from '@floating-ui-plus/web-components';
  import {
    emitExampleAction,
    floatingRoot,
    floatingTemplate,
    initializeExample,
    onFloatingTemplateMount,
    onFloatingOpenChange,
  } from './example-client';

  initializeExample('menu', (scope) => {
    const floating = floatingRoot(scope, '[data-menu-root]');
    const template = floatingTemplate(scope, '[data-menu-content]');
    floating.middleware = [offset(8), flip(), shift({padding: 18})];

    onFloatingTemplateMount(template, (element) => {
      element.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;
        const item = event.target.closest<HTMLElement>('[data-menu-item]');
        if (!item || !element.contains(item)) return;
        emitExampleAction(scope, `${item.dataset.label} selected`);
      });
    });
    onFloatingOpenChange(floating, ({open}) => {
      emitExampleAction(
        scope,
        open
          ? 'Menu opened · arrows and typeahead are active'
          : 'Menu closed',
      );
    });
  });
</script>
