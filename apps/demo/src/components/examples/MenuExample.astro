---
import {MENU_LABELS} from '../../example-data';
---

<article class="demo-card menu-card" data-demo="menu">
  <div class="card-top">
    <span class="number">C</span><span class="chip">roving focus</span>
  </div>
  <h3>Command menu</h3>
  <p>
    Arrow keys, looping, and typeahead share one list registry. Try typing
    “signal”.
  </p>
  <div class="card-action">
    <floating-root data-menu-root placement="bottom-start">
      <floating-reference>
        <button class="dark-button">
          Open navigator <span aria-hidden="true">⌄</span>
        </button>
      </floating-reference>
      <floating-portal>
        <floating-content>
          <div class="menu-panel">
            <div class="menu-heading">Jump to a field</div>
            <floating-list>
              {
                MENU_LABELS.map((label, index) => (
                  <floating-list-item label={label}>
                    <button
                      class="menu-item"
                      role="menuitem"
                      tabindex="-1"
                      data-menu-item
                      data-index={index}
                      data-label={label}
                    >
                      <span>{label}</span><kbd>{index + 1}</kbd>
                    </button>
                  </floating-list-item>
                ))
              }
            </floating-list>
          </div>
        </floating-content>
      </floating-portal>
    </floating-root>
  </div>
  <code>plugins = [click(), listNavigation(), typeahead()]</code>
</article>
