---
import {MENU_LABELS} from '../../example-data';
---

<article class="demo-card menu-card" data-demo="menu">
  <div class="card-top">
    <span class="number">C</span><span class="chip">roving focus</span>
  </div>
  <h3>Command menu</h3>
  <p>
    Arrow keys, looping, and typeahead share one list registry. Try typing
    “signal”.
  </p>
  <div class="card-action">
    <floating-root data-menu-root placement="bottom-start">
      <floating-reference>
        <button class="dark-button">
          Open navigator <span aria-hidden="true">⌄</span>
        </button>
      </floating-reference>
      <floating-portal>
        <floating-content>
          <div class="menu-panel">
            <div class="menu-heading">Jump to a field</div>
            <floating-list>
              {
                MENU_LABELS.map((label, index) => (
                  <floating-list-item label={label}>
                    <button
                      class="menu-item"
                      role="menuitem"
                      tabindex="-1"
                      data-menu-item
                      data-index={index}
                      data-label={label}
                    >
                      <span>{label}</span><kbd>{index + 1}</kbd>
                    </button>
                  </floating-list-item>
                ))
              }
            </floating-list>
          </div>
        </floating-content>
      </floating-portal>
    </floating-root>
  </div>
  <code>plugins = [click(), listNavigation(), typeahead()]</code>
</article>

<script>
  import {
    click,
    dismiss,
    flip,
    listNavigation,
    offset,
    role,
    shift,
    typeahead,
  } from '@floating-ui-plus/web-components';
  import {
    activeItems,
    closeFloating,
    configureFloating,
    emitExampleAction,
    floatingRoot,
    initializeExample,
    onFloatingOpenChange,
  } from './example-client';

  initializeExample('menu', (scope) => {
    const floating = floatingRoot(scope, '[data-menu-root]');
    const items = [
      ...scope.querySelectorAll<HTMLElement>('[data-menu-item]'),
    ];
    const labels = items.map((item) => item.dataset.label ?? null);
    const listRef = {current: items as Array<HTMLElement | null>};
    const labelRef = {current: labels};
    const active = activeItems(
      items,
      () => floating.controller.refresh(),
    );

    configureFloating(floating, {
      middleware: [offset(8), flip(), shift({padding: 18})],
      plugins: [
        click(),
        dismiss(),
        role({role: 'menu'}),
        listNavigation(() => ({
          listRef,
          activeIndex: active.value,
          loop: true,
          onNavigate: active.set,
        })),
        typeahead({
          listRef: labelRef,
          get activeIndex() {
            return active.value;
          },
          onMatch: (index) => {
            active.set(index);
            if (index != null) {
              items[index]?.focus({preventScroll: true});
            }
          },
        }),
      ],
    });

    items.forEach((item, index) => {
      item.addEventListener('click', (event) => {
        active.set(index);
        emitExampleAction(scope, `${labels[index]} selected`);
        closeFloating(floating, event);
      });
    });
    onFloatingOpenChange(floating, ({open}) => {
      if (!open) active.set(null);
      emitExampleAction(
        scope,
        open
          ? 'Menu opened · arrows and typeahead are active'
          : 'Menu closed',
      );
    });
  });
</script>
