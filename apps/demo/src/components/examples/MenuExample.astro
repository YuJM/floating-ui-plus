---
import {MENU_LABELS} from '../../example-data';
---

<article class="demo-card menu-card" data-demo="menu">
  <div class="card-top">
    <span class="number">C</span><span class="chip">roving focus</span>
  </div>
  <h3>Command menu</h3>
  <p>
    Arrow keys, looping, and typeahead share one list registry. Try typing
    “signal”.
  </p>
  <div class="card-action">
    <floating-root data-menu-root placement="bottom-start">
      <floating-reference>
        <button class="dark-button">
          Open navigator <span aria-hidden="true">⌄</span>
        </button>
      </floating-reference>
      <floating-portal>
        <floating-content data-menu-content>
          <template>
            <div class="menu-panel">
              <div class="menu-heading">Jump to a field</div>
              <floating-list>
                {
                  MENU_LABELS.map((label, index) => (
                    <floating-list-item label={label}>
                      <button
                        class="menu-item"
                        role="menuitem"
                        tabindex="-1"
                        data-menu-item
                        data-index={index}
                        data-label={label}
                      >
                        <span>{label}</span><kbd>{index + 1}</kbd>
                      </button>
                    </floating-list-item>
                  ))
                }
              </floating-list>
            </div>
          </template>
        </floating-content>
      </floating-portal>
    </floating-root>
  </div>
  <code>plugins = [click(), listNavigation(), typeahead()]</code>
</article>

<script>
  import {
    click,
    dismiss,
    flip,
    listNavigation,
    offset,
    role,
    shift,
    typeahead,
  } from '@floating-ui-plus/web-components';
  import {
    closeFloating,
    configureFloating,
    emitExampleAction,
    floatingContent,
    floatingRoot,
    floatingTemplateContent,
    initializeExample,
    onFloatingContentMount,
    onFloatingOpenChange,
  } from './example-client';

  initializeExample('menu', (scope) => {
    const floating = floatingRoot(scope, '[data-menu-root]');
    const content = floatingContent(scope, '[data-menu-content]');
    const templateContent = floatingTemplateContent(content);
    const labels = [
      ...templateContent.querySelectorAll<HTMLElement>('[data-menu-item]'),
    ].map((item) => item.dataset.label ?? null);
    let items: HTMLElement[] = [];
    const listRef = {current: [] as Array<HTMLElement | null>};
    const labelRef = {current: labels};
    let activeIndex: number | null = null;
    const active = {
      get value() {
        return activeIndex;
      },
      set(next: number | null) {
        activeIndex = next;
        items.forEach((item, itemIndex) => {
          item.tabIndex = itemIndex === next ? 0 : -1;
          item.dataset.active = String(itemIndex === next);
        });
        floating.controller.refresh();
      },
    };

    configureFloating(floating, {
      middleware: [offset(8), flip(), shift({padding: 18})],
      plugins: [
        click(),
        dismiss(),
        role({role: 'menu'}),
        listNavigation(() => ({
          listRef,
          activeIndex: active.value,
          loop: true,
          onNavigate: active.set,
        })),
        typeahead({
          listRef: labelRef,
          get activeIndex() {
            return active.value;
          },
          onMatch: (index) => {
            active.set(index);
            if (index != null) {
              items[index]?.focus({preventScroll: true});
            }
          },
        }),
      ],
    });

    onFloatingContentMount(content, () => {
      items = [
        ...content.querySelectorAll<HTMLElement>('[data-menu-item]'),
      ];
      listRef.current = items;
      active.set(active.value);
    });
    content.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const item = event.target.closest<HTMLElement>('[data-menu-item]');
      if (!item || !content.contains(item)) return;
      const index = Number(item.dataset.index);
      active.set(index);
      emitExampleAction(scope, `${labels[index]} selected`);
      closeFloating(floating, event);
    });
    onFloatingOpenChange(floating, ({open}) => {
      if (!open) active.set(null);
      emitExampleAction(
        scope,
        open
          ? 'Menu opened · arrows and typeahead are active'
          : 'Menu closed',
      );
    });
  });
</script>
