{
  "name": "floating-ui-plus-demo",
  "version": "0.0.5",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:messages": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy url baseLocale --emit-ts-declarations --silent",
    "generate:llms": "bun scripts/generate-llms.ts",
    "generate:fake-server-destinations": "bun scripts/generate-fake-server-destinations.ts",
    "dev": "bun run generate:messages && bun run generate:llms && astro dev --host 127.0.0.1 --port 5173",
    "preview": "astro preview --host 127.0.0.1",
    "build": "bun run generate:messages && bun run generate:llms && astro check && astro build",
    "typecheck": "bun run generate:messages && bun run generate:llms && astro check",
    "test:unit": "bun test test/unit",
    "test": "playwright test --config playwright.config.ts",
    "test:headed": "playwright test --config playwright.config.ts --headed",
    "test:ui": "playwright test --config playwright.config.ts --ui"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/starlight": "^0.41.6",
    "@astrojs/vue": "7.0.1",
    "@floating-ui-plus/vue": "workspace:^",
    "@floating-ui-plus/web-components": "workspace:^",
    "@inlang/paraglide-js": "^2.23.0",
    "astro": "7.1.4",
    "lucide-astro": "^0.556.0",
    "pretendard": "^1.3.9",
    "simple-icons": "^16.27.1",
    "starlight-links-validator": "^0.25.2",
    "starlight-package-managers": "^0.12.0",
    "starlight-typedoc": "^0.23.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@comneed/textby": "0.0.3",
    "@faker-js/faker": "^10.5.0",
    "@inlang/plugin-message-format": "^4.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "msw": "^2.15.0",
    "playwright": "^1.50.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "msw": {
    "workerDirectory": [
      "./public"
    ]
  }
}
