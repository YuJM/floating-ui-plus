{
  "name": "floating-ui-plus-demo",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:messages": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy url baseLocale --emit-ts-declarations --silent",
    "dev": "bun run generate:messages && astro dev --host 127.0.0.1 --port 5173",
    "preview": "astro preview --host 127.0.0.1",
    "build": "bun run generate:messages && astro check && astro build",
    "typecheck": "bun run generate:messages && astro check",
    "test:unit": "bun test test/unit",
    "test": "playwright test --config playwright.config.ts",
    "test:headed": "playwright test --config playwright.config.ts --headed",
    "test:ui": "playwright test --config playwright.config.ts --ui",
    "deploy:dry-run": "cf deploy --mode production --dry-run",
    "deploy": "cf deploy --mode production"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/vue": "7.0.1",
    "@floating-ui-plus/vue": "workspace:^",
    "@floating-ui-plus/web-components": "workspace:^",
    "@inlang/paraglide-js": "^2.23.0",
    "astro": "7.1.4",
    "lucide-astro": "^0.556.0",
    "pretendard": "^1.3.9",
    "simple-icons": "^16.27.1",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@inlang/plugin-message-format": "^4.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "playwright": "^1.50.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "4.102.0"
  }
}
