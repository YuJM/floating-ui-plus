{
  "files": [
    "../../packages/web/src/index.ts",
    "../../packages/web-components/src/index.ts",
    "../../packages/vue/src/index.ts"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "atomico",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@floating-ui-plus/web": ["../../packages/web/src/index.ts"],
      "@floating-ui-plus/web/*": ["../../packages/web/src/*"],
      "@floating-ui-plus/web-components": [
        "../../packages/web-components/src/index.ts"
      ],
      "@floating-ui-plus/web-components/*": [
        "../../packages/web-components/src/*"
      ],
      "@floating-ui-plus/vue": ["../../packages/vue/src/index.ts"],
      "@floating-ui-plus/vue/*": ["../../packages/vue/src/*"]
    }
  },
  "skipErrorChecking": true
}
