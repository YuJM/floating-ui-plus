    "lit": "^3.3.3",
    "urlpattern-polyfill": "^10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "playwright": "^1.50.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.5"
  }
}
