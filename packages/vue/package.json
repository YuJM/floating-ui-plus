{
  "name": "@floating-ui-plus/vue",
  "version": "0.6.1",
  "type": "module",
  "homepage": "https://fup.polcaneli.com/",
  "description": "Vue Floating UI composables and components for interactions, focus management, portals, collections, and search",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "USAGE.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "TEST_ENV=browser vitest run",
    "test:browser:headed": "PLAYWRIGHT_HEADLESS=false TEST_ENV=browser vitest run",
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "typecheck": "tsc -p tsconfig.json"
  },
  "author": "Floating UI contributors and Floating UI Plus contributors",
  "license": "MIT",
  "bugs": "https://github.com/floating-ui/floating-ui",
  "repository": {
    "type": "git",
    "url": "https://github.com/floating-ui-plus/floating-ui-plus.git",
    "directory": "packages/vue"
  },
  "keywords": [
    "floating-ui",
    "floating-ui-plus",
    "tooltip",
    "popover",
    "dropdown",
    "menu",
    "dialog",
    "popup",
    "positioning",
    "vue",
    "focus",
    "focus-management",
    "interactions",
    "portal",
    "teleport",
    "combobox",
    "search",
    "fuzzy-search",
    "collections",
    "headless-ui",
    "accessibility"
  ],
  "dependencies": {
    "@floating-ui-plus/web": "workspace:^",
    "@floating-ui/utils": "^0.2.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/vue": "^8.1.0",
    "@vue/server-renderer": "^3.5.22",
    "vue": "^3.5.22"
  },
  "peerDependencies": {
    "vue": ">=3.3.0"
  }
}
