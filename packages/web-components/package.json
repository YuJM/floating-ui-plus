{
  "name": "@floating-ui-plus/web-components",
  "version": "0.5.0",
  "type": "module",
  "homepage": "https://fup.polcaneli.com/",
  "description": "Floating UI custom elements with interactions, focus management, portals, collections, and search",
  "keywords": [
    "floating-ui",
    "floating-ui-plus",
    "web-components",
    "custom-elements",
    "atomico",
    "tooltip",
    "popover",
    "menu",
    "dialog",
    "focus-management",
    "portal",
    "headless-ui",
    "accessibility"
  ],
  "license": "MIT",
  "sideEffects": true,
  "files": [
    "dist",
    "USAGE.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:browser": "TEST_ENV=browser vitest run",
    "test:browser:headed": "PLAYWRIGHT_HEADLESS=false TEST_ENV=browser vitest run"
  },
  "dependencies": {
    "@floating-ui-plus/web": "workspace:^",
    "atomico": "^2.2.0"
  }
}
