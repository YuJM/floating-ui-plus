{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "features",
    "webComponents",
    "vue",
    "excluded",
    "reactOnly"
  ],
  "properties": {
    "webComponents": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "vue": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "features": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["web", "webComponents", "kind"]
      }
    }
  }
}
