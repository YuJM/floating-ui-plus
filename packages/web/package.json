{
  "name": "@floating-ui-plus/web",
  "version": "0.1.0",
  "type": "module",
  "description": "Framework-agnostic positioning and interaction primitives for the web",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js",
      "require": "./dist/utils.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:browser": "TEST_ENV=browser vitest run",
    "test:browser:headed": "PLAYWRIGHT_HEADLESS=false TEST_ENV=browser vitest run"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@floating-ui/utils": "^0.2.12",
    "focus-trap": "^8.2.2",
    "tabbable": "^6.5.0"
  }
}
