{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "ES2021"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@floating-ui/web": ["./packages/web/src/index.ts"],
      "@floating-ui/web/*": ["./packages/web/src/*"],
      "@floating-ui/lit": ["./packages/lit/src/index.ts"],
      "@floating-ui/lit/*": ["./packages/lit/src/*"]
    }
  }
}
