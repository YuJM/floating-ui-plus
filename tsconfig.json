{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "ES2021"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@floating-ui-plus/web": ["./packages/web/src/index.ts"],
      "@floating-ui-plus/web/*": ["./packages/web/src/*"],
      "@floating-ui-plus/web-components": ["./packages/web-components/src/index.ts"],
      "@floating-ui-plus/web-components/*": ["./packages/web-components/src/*"],
      "@floating-ui-plus/vue": ["./packages/vue/src/index.ts"],
      "@floating-ui-plus/vue/*": ["./packages/vue/src/*"]
    }
  }
}
