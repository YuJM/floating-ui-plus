{
  "name": "floating-ui-plus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun run --workspaces build",
    "typecheck": "bun run --workspaces typecheck",
    "test": "bun run --workspaces test",
    "dev": "bun run --workspaces --parallel dev",
    "dev:packages": "bun run --filter '@floating-ui/*' --parallel dev",
    "dev:demo": "bun run --filter floating-ui-lit-demo dev"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.17.0",
    "@vitest/browser-playwright": "^4.1.10",
    "axe-core": "^4.12.1",
    "jsdom": "^26.0.0",
    "playwright": "^1.50.0",
    "tsdown": "^0.22.14",
    "typescript": "~5.6.3",
    "vitest": "^4.1.10"
  }
}
